# URL privada del backend, utilizada únicamente en el servidor de Next.js.
API_BASE_URL=http://localhost:3000

# URL canónica pública del frontend para metadata y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Datos públicos confirmados; déjalos vacíos hasta contar con aprobación oficial.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADVISOR_URL=

# Activa la publicación de contactos del backend sólo después de verificar que
# su base de datos no contiene valores de demostración.
TRUST_BACKEND_PUBLIC_SETTINGS=false
