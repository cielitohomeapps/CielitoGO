# Server
PORT=3000
NODE_ENV=development

# Database
# Paste the Supabase PostgreSQL connection URI here; never commit a real URI.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
DB_SSL=true

# Optional PostgreSQL settings when running a local instance instead of Supabase
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=cielito_go
# PGUSER=postgres
# PGPASSWORD=

# Optional: PostgreSQL connection for automated tests
DB_TEST_URL=

# JWT
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRATION=24h
JWT_ISSUER=cielito-go-api
JWT_AUDIENCE=cielito-go-admin

# Initial administrator (required only when running the seed)
INITIAL_ADMIN_NAME=Administrador Cielito Go
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# Upload
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=10485760
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_IMAGE_PIXELS=40000000

# Request and rate limits
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
WEBHOOK_RATE_LIMIT_MAX=120
PUBLIC_FORM_RATE_LIMIT_MAX=20

# Set to 1 only when running behind one trusted reverse proxy
TRUST_PROXY=false

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
