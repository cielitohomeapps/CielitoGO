NODE_ENV=development
PORT=3000
JWT_SECRET=reemplazar-por-un-secreto-local-de-al-menos-32-caracteres
JWT_EXPIRATION=24h
JWT_ISSUER=cielito-go-api
JWT_AUDIENCE=cielito-go-admin

# Use DATABASE_URL o el bloque PG*, no ambos.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=cielito_go
PGUSER=postgres
PGPASSWORD=
DB_SSL=false
DB_TEST_URL=
PG_TEST_DATABASE=cielito_go_test

FRONTEND_URL=http://localhost:3001
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
WEBHOOK_RATE_LIMIT_MAX=120
PUBLIC_FORM_RATE_LIMIT_MAX=20

UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=10485760
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_IMAGE_PIXELS=40000000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cielito-go
ALLOW_EPHEMERAL_UPLOADS=false

WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Sólo durante el seed inicial; eliminar después.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=
DATA_RETENTION_DAYS=730
ALLOW_DATABASE_RESTORE=false
